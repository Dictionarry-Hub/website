{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dictionarry-search-clicks",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dictionarry-clicks",
			// Placeholder until the production database is created with
			// `wrangler d1 create`; local dev ignores it.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Overridden in production to the GitHub Pages origin.
		"ALLOWED_ORIGIN": "*"
	}
}
