{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"watcher,vite\" -c \"blue,green\" \"tsx scripts/watchMarkdown.ts\" \"vite --host\"",
    "build": "vite build",
    "build:ssg": "vite build && node scripts/prerender.js",
    "db:dev": "tsx scripts/db.ts --repo https://github.com/Dictionarry-Hub/database --branch dev",
    "db:stable": "tsx scripts/db.ts --repo https://github.com/Dictionarry-Hub/database --branch stable",
    "db:watch": "tsx scripts/watchMarkdown.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tsconfig/svelte": "^5.0.4",
    "@types/chokidar": "^1.7.5",
    "@types/node": "^24.0.7",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "svelte": "^5.34.7",
    "svelte-check": "^4.2.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "lucide-svelte": "^0.525.0",
    "marked": "^16.0.0",
    "plyr": "^3.8.3",
    "prismjs": "^1.30.0",
    "simple-icons": "^15.4.0",
    "tinro": "^0.6.12",
    "yaml": "^2.6.1"
  }
}
